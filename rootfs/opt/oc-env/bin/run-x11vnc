#!/usr/bin/env bash
# VNC server for the virtual display, loopback only.
#
# -shared/-forever are what let several viewers attach to the same desktop at
# once, instead of each new one disconnecting the last.
set -euo pipefail
export DISPLAY="${DESKTOP_DISPLAY:-:1}"

# pitchfork gates this on xvfb, but container mode is still marked
# experimental, so confirm the display really is accepting connections rather
# than trusting start ordering.
for _ in $(seq 1 60); do
  xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1 && break
  sleep 0.5
done

args=(
  -display "${DISPLAY}"
  -rfbport "${VNC_PORT:-5900}"
  -localhost
  -forever
  -shared
  -repeat
  -xkb
  -noxrecord -noxfixes -noxdamage
  -nomodtweak
  -quiet
)

if [[ -n "${VNC_PASSWORD:-}" ]]; then
  pwfile="${HOME}/.vnc/passwd"
  mkdir -p "$(dirname "${pwfile}")"
  x11vnc -storepasswd "${VNC_PASSWORD}" "${pwfile}" >/dev/null 2>&1
  args+=(-rfbauth "${pwfile}")
else
  args+=(-nopw)
fi

[[ "${VNC_VIEW_ONLY:-false}" == "true" ]] && args+=(-viewonly)

exec x11vnc "${args[@]}"
