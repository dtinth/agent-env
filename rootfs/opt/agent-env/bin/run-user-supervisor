#!/usr/bin/env bash
# A second, unprivileged pitchfork supervisor owned by the dev user.
#
# The system supervisor (PID 1) manages the container's infrastructure. This one
# manages whatever the person using the container wants running — dev servers,
# watchers, queue workers — with its own state, its own socket and its own logs.
# It is deliberately not privileged, and it cannot see or touch system daemons.
set -euo pipefail

# Use this user's own directories, not the system supervisor's.
unset PITCHFORK_CONFIG_DIR
export PITCHFORK_STATE_DIR="${HOME}/.local/state/pitchfork"
mkdir -p "${PITCHFORK_STATE_DIR}" "${HOME}/.config/pitchfork"

args=(--boot)

# The web UI is told its prefix so it can be reverse-proxied under a path.
# It binds loopback only; the gateway is what exposes it.
if [[ "${USER_WEB_ENABLE:-true}" == "true" ]]; then
  args+=(--web-port "${USER_WEB_PORT:-4747}" --web-path "${USER_WEB_PATH:-pitchfork}")
fi

# --boot starts any daemon marked `boot_start = true` in the user's config,
# which is where the OpenCode server is defined.
exec pitchfork supervisor run "${args[@]}"
