#!/usr/bin/env bash
# dufs — browse, upload and download the workspace over HTTP.
#
# A daemon of the *user's* supervisor, so it runs as them, writes files as them,
# and they can restart it without sudo. Bound to loopback; the gateway is the
# only way in, and --path-prefix makes its UI work under one.
set -euo pipefail

root="${DUFS_ROOT:-${WORKSPACE_DIR:-/workspace}}"
mkdir -p "${root}"

args=(
  "${root}"
  --bind 127.0.0.1
  --port 5000
  --path-prefix "/${DUFS_PATH:-~env/files}"
  # Everything, symlinks included: a symlink in the workspace to somewhere else
  # on the box should work. dufs runs as the user, so it reaches nothing they
  # can't, and it is behind the gateway's auth.
  --allow-all
  # Serve a directory's index.html instead of its listing.
  --render-try-index
)

# DUFS_ARGS overrides nothing above; it appends, so you can add --hidden, --auth
# or anything else dufs takes.
if [[ -n "${DUFS_ARGS:-}" ]]; then
  read -ra extra <<<"${DUFS_ARGS}"
  args+=("${extra[@]}")
fi

exec dufs "${args[@]}"
