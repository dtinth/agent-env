#!/usr/bin/env bash
# The command the operator gave as PRIMARY_COMMAND, supervised at / on
# PRIMARY_PORT. (A component that serves / runs as that component's daemon
# instead, and then there is no PRIMARY_COMMAND.)
#
# Runs in the dev user's own supervisor, which does not inherit the container's
# environment, so everything comes from what the entrypoint published.
set -euo pipefail
env_file=/run/agent-env/env
value() { sed -n "s/^$1=//p" "${env_file}" 2>/dev/null | head -1; }

PRIMARY_PORT="$(value PRIMARY_PORT)"
export PRIMARY_PORT PORT="${PRIMARY_PORT}"
workdir="$(value WORKSPACE_DIR)"
cd "${workdir:-/workspace}"

# Kept out of the env file, which `agent-env` sources as shell: a command line
# is the one value that cannot be trusted to survive that.
exec bash -lc "$(cat /run/agent-env/primary-command)"
