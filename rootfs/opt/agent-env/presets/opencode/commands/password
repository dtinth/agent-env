#!/usr/bin/env bash
# help: Print the OpenCode server password
#
# The server mints its own and records it in the user's service.json; the
# gateway injects it, so this is only for talking to the server directly.
set -euo pipefail
# The server runs as the dev user, so its state is there whatever HOME the caller
# has (a root shell has /root).
user="$(sed -n 's/^USER_NAME=//p' /run/agent-env/env 2>/dev/null | head -1)"
jq -r '.password // empty' "/home/${user:-dev}/.local/state/opencode/service.json"
