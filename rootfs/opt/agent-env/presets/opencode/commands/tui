#!/usr/bin/env bash
# help: Attach the OpenCode v2 TUI to the server the web UI talks to
#
# Run it from the browser terminal or any shell: `agent-env tui`.
set -uo pipefail
export TERM="${TERM:-xterm-256color}"

# The runtime configuration, the way the healthcheck reads it. Trusting the
# inherited environment instead is what made `agent-env tui` from an SSH
# session disagree with the web UI: a login shell inherits neither the
# container's environment nor the daemon's.
env_file=/run/agent-env/env
value() { sed -n "s/^$1=//p" "${env_file}" 2>/dev/null | head -1; }

workdir="$(value WORKSPACE_DIR)"
workdir="${workdir:-${WORKSPACE_DIR:-/workspace}}"
cd "${workdir}" || cd "${HOME}"

# shellcheck disable=SC1091
[[ -r /etc/profile ]] && . /etc/profile

port="$(value PRIMARY_PORT)"
port="${port:-${PRIMARY_PORT:-3000}}"

# The server is a daemon of the user's own supervisor now, so it may still be
# coming up when a browser opens the terminal. Wait for it rather than showing a
# connection error that needs a page reload.
for _ in $(seq 1 120); do
  (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null && break
  printf '\rwaiting for the OpenCode server on port %s… ' "${port}"
  sleep 1
done
printf '\r\033[K'

exec opencode --server "http://127.0.0.1:${port}" "${workdir}"
