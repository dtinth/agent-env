#!/usr/bin/env bash
# Small operator helper for the running container.
set -euo pipefail

COMPONENTS_TOOL=/opt/agent-env/bin/agent-env-components

# Components are the user's: installing one runs as them (the tool sudos for
# the parts that need root), and so does reading what is installed.
case "${1:-}" in
  component|components)
    exec "${COMPONENTS_TOOL}" "${@:2}"
    ;;
esac
case "${1:-}:${2:-}" in
  logs:provision)
    user="$(sed -n 's/^USER_NAME=//p' /run/agent-env/env 2>/dev/null | head -1)"
    log="/home/${user:-dev}/.local/state/agent-env/provision.log"
    if [[ -s "${log}" ]]; then exec cat "${log}"; fi
    echo "no provision scripts ran at the last start (none in /etc/agent-env/provision.d)"
    exit 0
    ;;
esac

# The primary service is a daemon of the dev user's own supervisor, not the
# system one, so its logs and its start/stop/restart go there. This runs before
# the sudo re-exec below, which would only land in the wrong supervisor.
case "${1:-}:${2:-}" in
  logs:primary|restart:primary|start:primary|stop:primary)
    user="$(sed -n 's/^USER_NAME=//p' /run/agent-env/env 2>/dev/null | head -1)"
    user="${user:-dev}"
    pf_args=("$1")
    [[ "$1" == logs ]] && pf_args+=(--follow)
    pf_args+=(primary)
    if [[ "$(id -un)" == "${user}" ]]; then exec pitchfork "${pf_args[@]}"; fi
    if [[ "$(id -u)" -eq 0 ]]; then exec runuser -l "${user}" -c "pitchfork ${pf_args[*]}"; fi
    echo "agent-env $1 primary must run as ${user} or root." >&2
    exit 1
    ;;
esac

# The system supervisor is root-only on purpose, so that the dev user's own
# pitchfork stays theirs. These commands need it, so re-run them under sudo
# rather than loosening the permissions on it.
case "${1:-help}" in
  status|logs|restart|start|stop|config|daemons|top)
    if [[ "$(id -u)" -ne 0 ]]; then
      if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        exec sudo -n "$0" "$@"
      fi
      echo "agent-env $1 manages the container's system services and needs root." >&2
      echo "Run it with sudo, or from a root shell (docker exec ...)." >&2
      echo "For your own daemons, use \`pitchfork\` (see: agent-env mine)." >&2
      exit 1
    fi
    # Root must not read the operator's project pitchfork.toml: its lockfile in
    # /tmp/fslock is created by whoever got there first, and fs.protected_regular
    # then refuses root's O_CREAT open of a file the other user owns.
    ORIG_PWD="${PWD}"
    cd /
    ;;
esac

export PITCHFORK_STATE_DIR=/var/lib/pitchfork
export PITCHFORK_CONFIG_DIR=/opt/agent-env/pitchfork

RUN_ENV=/run/agent-env/env
# shellcheck disable=SC1090
[[ -r "${RUN_ENV}" ]] && . "${RUN_ENV}"

usage() {
  cat <<EOF
agent-env — manage this workstation

  agent-env component ...       Install, list and remove components
                                (agent-env component help)
  agent-env status              Show the state of every service
  agent-env urls                Print the URLs this container serves
  agent-env logs [service]      Follow logs (all services, or one)
  agent-env logs provision      What the startup scripts did at the last start
  agent-env restart <service>   Restart one service (e.g. primary, caddy)
  agent-env start <service>     Start one service
  agent-env stop <service>      Stop one service
  agent-env top                 pitchfork's interactive dashboard
  agent-env config              Show the rendered gateway configuration
  agent-env daemons             Show the rendered daemon definitions
  agent-env mine                List *your* daemons, not the system's
  agent-env x-cookie            Print the X cookie, to drive the display remotely

The system services above belong to the root supervisor (these commands sudo
into it for you). Your own daemons, the components' among them, live in a
second, unprivileged supervisor: run \`pitchfork\` directly, and define them in
~/.config/pitchfork/config.toml or a pitchfork.toml beside your code.

Services are supervised by pitchfork, so anything it can do is also available
by running \`pitchfork\` directly.
EOF
}

case "${1:-help}" in
  status)
    printf '\033[1mSystem services\033[0m\n'
    pitchfork list
    if [[ -n "${SUDO_USER:-}" ]]; then
      printf '\n\033[1mYour daemons\033[0m (%s) — manage with `pitchfork`\n' "${SUDO_USER}"
      (
        cd "${ORIG_PWD:-/}" 2>/dev/null || cd /
        sudo -u "${SUDO_USER}" -H env -u PITCHFORK_STATE_DIR -u PITCHFORK_CONFIG_DIR \
          pitchfork list || echo "  (none)"
      )
    fi
    ;;
  mine)
    exec env -u PITCHFORK_STATE_DIR -u PITCHFORK_CONFIG_DIR pitchfork list
    ;;
  urls)
    # From the same record the index is rendered from, so the two agree.
    exec "${COMPONENTS_TOOL}" urls
    ;;
  logs)
    if [[ -n "${2:-}" ]]; then exec pitchfork logs --follow "$2"; fi
    exec pitchfork logs --follow
    ;;
  restart|start|stop)
    [[ -n "${2:-}" ]] || { echo "usage: agent-env $1 <service>" >&2; exit 1; }
    exec pitchfork "$1" "$2"
    ;;
  top)
    exec pitchfork tui
    ;;
  config)
    cat /etc/caddy/Caddyfile
    ;;
  x-cookie)
    # The hex cookie for the virtual display, for pointing a GUI application on
    # another machine at it. See "Running a GUI app from your own machine" in
    # AGENTS.md.
    exec xauth -f "${XAUTHORITY:-/home/${USER_NAME:-dev}/.Xauthority}" \
      list "${DESKTOP_DISPLAY:-:1}"
    ;;
  daemons)
    cat "${PITCHFORK_CONFIG_DIR}/config.toml"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
