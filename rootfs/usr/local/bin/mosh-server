#!/bin/sh
# mosh-server wrapper: keep the mosh session on the image's one locale.
#
# mosh-client reads the *client's* locale and forwards it to mosh-server as
# `-l NAME=VALUE` pairs over mosh's own channel -- so the LANG/LC_* that sshd
# here strips from AcceptEnv (see the Dockerfile and the sshd drop-in) sail
# straight past into the session anyway. The image carries a single locale,
# C.UTF-8; a forwarded en_US.UTF-8 does not exist here, so every shell in the
# mosh session warns about setlocale before it does anything.
#
# Drop the client's locale pairs and pin the session to C.UTF-8 -- a UTF-8
# locale the image actually has, so mosh stays happy about UTF-8 and the shells
# are quiet. This is the same policy sshd follows for an SSH session.
real=/usr/bin/mosh-server
count=$#
while [ "$count" -gt 0 ]; do
  arg=$1; shift; count=$((count - 1))
  if [ "$arg" = "-l" ] && [ "$count" -gt 0 ]; then
    case "$1" in
      LANG=* | LANGUAGE=* | LC_*) shift; count=$((count - 1)); continue ;;
    esac
  fi
  set -- "$@" "$arg"
done
exec "$real" "$@" -l LANG=C.UTF-8 -l LC_ALL=C.UTF-8
