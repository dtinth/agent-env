# =============================================================================
# agent-env configuration. Copy to `.env` and edit.
# Every variable here has a working default unless marked REQUIRED.
# Any variable can also be supplied as <NAME>_FILE pointing at a file, for
# Docker/Kubernetes secrets: e.g. GOOGLE_CLIENT_SECRET_FILE=/run/secrets/gcs
# =============================================================================

# --- Gateway -----------------------------------------------------------------
# The externally reachable base URL. Must match what users type in the browser,
# and must match the redirect URI you register with Google.
PUBLIC_URL=http://localhost:8080

# Where the agent-browser dashboard is reachable. It needs its own origin
# rather than a path, so it gets a second port on the SAME hostname — the
# oauth2-proxy session cookie is host-scoped and ignores the port, so one
# sign-in covers both and only one redirect URI is registered with Google.
# Derived from PUBLIC_URL's host plus DASHBOARD_GATEWAY_PORT when unset.
# DASHBOARD_PUBLIC_URL=http://localhost:8081

# Ports inside the container (host ports are mapped in docker-compose.yml).
GATEWAY_PORT=8080
DASHBOARD_GATEWAY_PORT=8081
# GATEWAY_LOG_LEVEL=INFO

# --- Authentication ----------------------------------------------------------
# google : Google sign-in via oauth2-proxy (recommended)
# basic  : HTTP basic auth, useful for local runs
# none   : no gateway auth at all — only behind your own authenticating proxy
AUTH_MODE=google

# REQUIRED when AUTH_MODE=google. Create an OAuth 2.0 "Web application" client
# at https://console.cloud.google.com/apis/credentials and set its authorised
# redirect URI to  <PUBLIC_URL>/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The secret can arrive three ways — this variable, a file, or oauth2-proxy's
# own variable. The first two are handed over as --client-secret-file so the
# value never lands in `ps`; the third is passed straight through.
# GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
# OAUTH2_PROXY_CLIENT_SECRET=
# OAUTH2_PROXY_CLIENT_ID=

# Who may sign in. At least one of these is REQUIRED when AUTH_MODE=google,
# otherwise any Google account on the internet could get in.
ALLOWED_EMAILS=you@example.com
# ALLOWED_EMAIL_DOMAINS=example.com

# Optional: restrict to Google Workspace group membership. Needs a service
# account with domain-wide delegation and the Admin SDK enabled.
# GOOGLE_GROUPS=eng@example.com
# GOOGLE_ADMIN_EMAIL=admin@example.com
# GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-sa.json

# Persist this so sessions survive a restart. Generate with:
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
# If unset, one is generated and stored in the opencode-config volume.
# OAUTH2_PROXY_COOKIE_SECRET=
# AUTH_SESSION_TTL=168h
# AUTH_SESSION_REFRESH=1h

# Used only when AUTH_MODE=basic. A password is generated and logged if unset.
# GATEWAY_USER=opencode
# GATEWAY_PASSWORD=

# --- OpenCode v2 -------------------------------------------------------------
# Basic-auth password for the OpenCode server itself. Users never see it (the
# gateway injects it), and CLI/TUI clients in the container use it too.
# Generated and persisted if unset.
# OPENCODE_SERVER_PASSWORD=

OPENCODE_WORKDIR=/workspace
# OPENCODE_PORT=4096

# Provider credentials. Anything OpenCode understands works here; alternatively
# sign in interactively with `/connect` in the TUI (it persists in the volume).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Inline OpenCode config, if you would rather not mount a file. This is read by
# opencode2 directly and takes precedence over ~/.config/opencode/opencode.json
# OPENCODE_CONFIG_CONTENT={"model":"anthropic/claude-opus-5"}

# --- SSH ---------------------------------------------------------------------
SSH_ENABLE=true
# Public keys, newline- or semicolon-separated.
SSH_AUTHORIZED_KEYS=
# Enables password authentication for the `dev` user. Prefer keys.
# SSH_PASSWORD=

# mosh is installed too. The client chooses the UDP port, so connect with:
#   mosh -p 60000:60010 --ssh="ssh -p 2222" dev@host
# and keep the published range (HOST_MOSH_PORTS in compose) in step with it.

# --- What lives at / ---------------------------------------------------------
# OpenCode is the default occupant of /, not a requirement of the image. Turn it
# off and / proxies to PRIMARY_PORT instead — whatever you are running in the
# workspace. With nothing listening there, / serves the /~env/ index (under a
# 502, so an ingress health check still reports the truth) and your dev server
# takes over the moment it binds.
#
# Two things follow this setting: the browser terminal becomes a login shell
# rather than the OpenCode TUI, and the gateway stops injecting OpenCode's
# basic-auth credential at / — it exists to reach OpenCode and is never sent to
# an application that isn't OpenCode.
# OPENCODE_ENABLE=false
# PRIMARY_PORT=3000

# --- Desktop (noVNC at <PUBLIC_URL>/~env/desktop) ----------------------------
DESKTOP_ENABLE=true

# Display geometry. Either WxH or WxHxD (depth 8/15/16/24/30); depth defaults
# to 24. An unparseable value fails at startup rather than silently.
DESKTOP_RESOLUTION=1920x1080x24
# ...or set the parts individually instead:
# DESKTOP_WIDTH=1920
# DESKTOP_HEIGHT=1080
# DESKTOP_DEPTH=24
# DESKTOP_DPI=96

# Several viewers can share the desktop simultaneously (x11vnc -shared, and
# websockify forks per browser) — nothing to configure for that.

# Extra VNC password on top of the gateway auth. Usually unnecessary.
# VNC_PASSWORD=
# VNC_VIEW_ONLY=false

# --- Browser TUI (ttyd at <PUBLIC_URL>/~env/terminal) ------------------------
TTYD_ENABLE=true
TTYD_WRITABLE=true
# TTYD_FONT_SIZE=14
# Set to `shell` to get a plain bash login shell instead of the TUI.
# TTYD_COMMAND=tui

# --- File manager (dufs, at <PUBLIC_URL>/~env/files) --------------------------
# Browse, upload and download the workspace. Runs as the dev user under their
# own supervisor, behind the gateway auth.
DUFS_ENABLE=true
# DUFS_ROOT=/workspace
# DUFS_PATH=~env/files
# Appended to the defaults (upload, delete, search, archive). --allow-symlink is
# off on purpose: it would let a symlink escape the served root.
# DUFS_ARGS=--allow-symlink

# --- agent-browser -----------------------------------------------------------
AB_DASHBOARD_ENABLE=true

# agent-browser defaults to headed Chromium on the virtual display, so you can
# watch it work over noVNC. That default lives in the right place —
# ~/.agent-browser/config.json — rather than in an environment variable, which
# would override any project's own ./agent-browser.json.
# Uncomment to force headless for the whole container:
# AGENT_BROWSER_HEADED=false
# AI_GATEWAY_API_KEY=   # enables `agent-browser chat`

# --- Toolchain ---------------------------------------------------------------
# A repo's mise.toml is not loaded until trusted (`mise trust`). To keep more
# distance from repository content, MISE_SAFE=1 blocks its hooks, tasks and
# templates while still resolving tool versions.
# MISE_SAFE=1
# Extra global tools installed by mise at startup, space-separated.
# MISE_TOOLS=python@3.13 go@latest ruby@3.4

# --- Supervision -------------------------------------------------------------
# pitchfork runs as PID 1 in container mode. Raise to debug/trace when a service
# will not come up.
# PITCHFORK_LOG_LEVEL=info

# The dev user gets a second, unprivileged pitchfork supervisor. It runs the
# OpenCode server plus whatever else you define in
# ~/.config/pitchfork/config.toml, so you can restart them without sudo.
# Set false only if you do not want the OpenCode server started for you.
USER_SUPERVISOR_ENABLE=true

# pitchfork's web dashboard for those daemons, served at <PUBLIC_URL>/pitchfork
# behind the gateway auth. It can start, stop and restart daemons, stream logs
# and edit the config.
USER_WEB_ENABLE=true
# Must be a single [A-Za-z0-9_-] segment: pitchfork rejects anything else, which
# is why this one service sits outside the /~env/ prefix.
# USER_WEB_PATH=pitchfork
# USER_WEB_PORT=4747

# --- Docker inside the container (opt-in) -------------------------------------
# A rootless Docker engine owned by the dev user, so an agent can bring up a
# database or any other container without reaching the host's docker socket.
# `docker` and `docker compose` are already in the image; this only decides
# whether the daemon starts.
#
# It is off by default because it does not work in a stock container: the host
# has to relax the sandbox around this one. All four are required, and the
# entrypoint refuses to start the daemon (with a message naming the missing
# ones) rather than crash-looping if any are absent:
#
#   --cap-add SYS_ADMIN                       setuid newuidmap needs it to map
#                                             the subuid range
#   --security-opt seccomp=unconfined         runc joins a session keyring per
#                                             container; keyctl is not in the
#                                             default profile
#   --security-opt systempaths=unconfined     the daemon sets net.ipv4.ip_forward
#                                             in its own netns, and /proc/sys is
#                                             read-only otherwise
#   --device /dev/net/tun                     slirp4netns builds a tap device
#
# That is a real widening of what code in this container can do — weigh it
# against the isolation the rest of the image is built on. It is still well
# short of --privileged.
# DOCKER_ROOTLESS_ENABLE=false
# Image and container storage. Defaults into the home volume so pulls survive
# a container recreate.
# DOCKER_ROOTLESS_DATA_ROOT=/home/dev/.local/share/docker
# Extra flags appended to dockerd.
# DOCKER_ROOTLESS_ARGS=--debug

# --- Users -------------------------------------------------------------------
# You work as `dev` (uid 1000), which has passwordless sudo. The desktop, the
# TUI, SSH and Chromium all run as that user. Caddy and oauth2-proxy run as a
# separate shell-less `gateway` account with no sudo.

# --- What persists -----------------------------------------------------------
# Three volumes, all worth having (see compose.example.yaml):
#   /workspace         your code
#   /home/dev          installed tools, dotfiles, sessions, provider logins
#   /var/lib/agent-env generated SSH host keys
# Tools declared with `mise use -g` are recorded in the home volume and
# reinstalled at boot; the installs themselves live in the image.

# --- Generated identity ------------------------------------------------------
# SSH host keys are generated on first start and kept here. Mount a volume at
# this path or they change whenever you recreate the container, and every client
# warns about a changed host key. The image ships no host keys on purpose.
# AGENT_ENV_STATE_DIR=/var/lib/agent-env

# The virtual display is cookie-protected. Set this to also let it accept TCP,
# for pointing a GUI app on another machine at it — see the README. Do not
# publish the port.
# X_TCP_ENABLE=false

# --- Misc --------------------------------------------------------------------
TZ=Asia/Bangkok
# Match a mounted host directory's ownership.
# PUID=1000
# PGID=1000
